{%- comment -%}
  FM - Liens rayons
  Liste de liens HTML vers les rayons (collections), à placer dans le pied de page.
  But : que Google trouve les rayons, puis les fiches produit qu'ils listent.
  Le catalogue pro (/pages/catalogue) n'est pas modifié.
{%- endcomment -%}

{%- liquid
  assign rayons = section.settings.rayons
  if rayons == blank
    assign handles = 'fruits,legumes,cremerie,boucherie,volaille,charcuterie,poissonnerie,surgeles,epicerie-salee,epicerie-sucree,boissons,produits-du-monde,arrivages-rungis,consommables,hygiene' | split: ','
  endif
-%}

{%- style -%}
  .fm-rayons-liens-{{ section.id }} {
    padding: 24px 0;
  }
  .fm-rayons-liens-{{ section.id }} .fm-rayons-liens__titre {
    margin: 0 0 12px;
    font-size: 1.15em;
    font-weight: 600;
  }
  .fm-rayons-liens-{{ section.id }} .fm-rayons-liens__liste {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fm-rayons-liens-{{ section.id }} .fm-rayons-liens__liste a {
    color: inherit;
    text-decoration: none;
  }
  .fm-rayons-liens-{{ section.id }} .fm-rayons-liens__liste a:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

<nav class="fm-rayons-liens fm-rayons-liens-{{ section.id }}" aria-label="{{ section.settings.titre | default: 'Nos rayons' | escape }}">
  <div class="page-width">
    {%- if section.settings.titre != blank -%}
      <h2 class="fm-rayons-liens__titre">{{ section.settings.titre | escape }}</h2>
    {%- endif -%}
    <ul class="fm-rayons-liens__liste" role="list">
      {%- if handles -%}
        {%- for handle in handles -%}
          {%- assign rayon = collections[handle] -%}
          {%- if rayon != blank and rayon.products_count > 0 -%}
            <li><a href="{{ rayon.url }}">{{ rayon.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for rayon in rayons -%}
          <li><a href="{{ rayon.url }}">{{ rayon.title | escape }}</a></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</nav>

{% schema %}
{
  "name": "FM - Liens rayons",
  "tag": "section",
  "class": "fm-rayons-liens-section",
  "settings": [
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Nos rayons"
    },
    {
      "type": "collection_list",
      "id": "rayons",
      "label": "Rayons",
      "limit": 30,
      "info": "Laisser vide pour afficher les rayons principaux : fruits, légumes, crémerie, boucherie, volaille, charcuterie, poissonnerie, surgelés, épicerie salée et sucrée, boissons, produits du monde, arrivages Rungis, consommables, hygiène."
    }
  ],
  "presets": [
    {
      "name": "FM - Liens rayons"
    }
  ]
}
{% endschema %}
