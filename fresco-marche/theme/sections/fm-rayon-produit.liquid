{%- comment -%}
  FM - Rayon du produit
  Sur la fiche produit : fil d'Ariane vers le rayon, et produits du même rayon
  en liens HTML rendus par le serveur (le bloc « produits similaires » actuel
  se charge en JavaScript et Google ne le suit pas).
  Aucun prix affiché : ils restent réservés aux comptes pro.
{%- endcomment -%}

{%- liquid
  assign exclus = 'bons-plans,meilleures-ventes,nouveaux-produits,arrivages-rungis,all,frontpage' | split: ','
  assign principaux = 'fruits,legumes,cremerie,boucherie,volaille,boeuf,charcuterie,poissonnerie,surgeles,epicerie-salee,epicerie-sucree,boissons,produits-du-monde,consommables,hygiene' | split: ','
  assign rayon = nil
  assign sous_rayon = nil

  for c in product.collections
    if exclus contains c.handle
      continue
    endif
    if principaux contains c.handle
      if rayon == nil
        assign rayon = c
      endif
    elsif sous_rayon == nil
      assign sous_rayon = c
    endif
  endfor

  if sous_rayon != nil
    assign liste = sous_rayon
  else
    assign liste = rayon
  endif
-%}

{%- style -%}
  .fm-rayon-produit-{{ section.id }} {
    padding: 16px 0;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__ariane ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9em;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__ariane li + li::before {
    content: '›';
    margin-right: 4px;
    opacity: 0.6;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__ariane a {
    color: inherit;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__titre {
    margin: 0 0 12px;
    font-size: 1.15em;
    font-weight: 600;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  @media screen and (min-width: 750px) {
    .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__grille {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__grille a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__grille img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    margin-bottom: 6px;
    border-radius: 8px;
    background: #fff;
  }
  .fm-rayon-produit-{{ section.id }} .fm-rayon-produit__tout {
    color: inherit;
    font-weight: 600;
  }
{%- endstyle -%}

<div class="fm-rayon-produit fm-rayon-produit-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.afficher_ariane -%}
      <nav class="fm-rayon-produit__ariane" aria-label="Fil d'Ariane">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Accueil</a></li>
          {%- if rayon -%}
            <li><a href="{{ rayon.url }}">{{ rayon.title | escape }}</a></li>
          {%- endif -%}
          {%- if sous_rayon -%}
            <li><a href="{{ sous_rayon.url }}">{{ sous_rayon.title | escape }}</a></li>
          {%- endif -%}
          <li aria-current="page">{{ product.title | escape }}</li>
        </ol>
      </nav>
    {%- endif -%}

    {%- if section.settings.afficher_similaires and liste and liste.products_count > 1 -%}
      <div class="fm-rayon-produit__similaires">
        <h2 class="fm-rayon-produit__titre">Du même rayon : {{ liste.title | escape }}</h2>
        <ul class="fm-rayon-produit__grille" role="list">
          {%- assign affiches = 0 -%}
          {%- for p in liste.products -%}
            {%- if p.id == product.id -%}
              {%- continue -%}
            {%- endif -%}
            {%- if affiches >= section.settings.nombre -%}
              {%- break -%}
            {%- endif -%}
            {%- assign affiches = affiches | plus: 1 -%}
            <li>
              <a href="{{ p.url }}">
                {%- if p.featured_image -%}
                  {%- assign texte_alt = p.featured_image.alt | default: p.title -%}
                  {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '(min-width: 750px) 25vw, 50vw', alt: texte_alt }}
                {%- endif -%}
                <span>{{ p.title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <a class="fm-rayon-produit__tout" href="{{ liste.url }}">Voir tout le rayon {{ liste.title | escape }} →</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FM - Rayon du produit",
  "tag": "section",
  "class": "fm-rayon-produit-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "afficher_ariane",
      "label": "Afficher le fil d'Ariane",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afficher_similaires",
      "label": "Afficher « Du même rayon »",
      "default": true
    },
    {
      "type": "range",
      "id": "nombre",
      "label": "Nombre de produits du même rayon",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "FM - Rayon du produit"
    }
  ]
}
{% endschema %}
