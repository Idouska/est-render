// cSAV Copilot — schéma multi-tenant.
//
// Règle d'or : toute table métier porte `merchantId` et toute requête applicative
// filtre dessus. Aucune requête ne doit traverser deux marchands.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// Regroupe les boutiques d'un même exploitant.
///
/// Le `merchantId` reste la frontière d'isolation : aucune requête métier ne
/// traverse l'organisation. Elle sert uniquement à savoir vers quelles autres
/// boutiques un utilisateur a le droit de basculer, et à quel groupe rattacher
/// une nouvelle installation Shopify.
model Organization {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())

  merchants Merchant[]
}

model Merchant {
  id             String  @id @default(cuid())
  organizationId String?
  shopDomain     String  @unique // ex. ma-boutique.myshopify.com
  name           String?
  status         MerchantStatus @default(ACTIVE)

  // Seuil de confiance à partir duquel une réponse peut partir sans validation.
  // autoSendEnabled reste false en phase 1 : on ne produit que des brouillons.
  autoSendEnabled   Boolean @default(false)
  autoSendThreshold Float   @default(0.9)

  // Base légale RGPD : durée de conservation des mails ingérés, en jours.
  retentionDays Int @default(365)

  // Identité affichée dans l'application. Distincte de `name`, qui vient de
  // Shopify : un marchand veut souvent afficher son enseigne plutôt que la
  // raison sociale, et son logo plutôt que deux initiales.
  brandName String?
  logoUrl   String?

  /// Gabarit de lien de suivi, `{tracking}` remplacé par le numéro. Vide, on
  /// utilise le lien fourni par Shopify — qui manque chez certains
  /// transporteurs, d'où la possibilité de le forcer.
  trackingUrlTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization?      @relation(fields: [organizationId], references: [id])
  shopify             ShopifyConnection?
  mailboxes           GmailConnection[]
  users               User[]
  tickets             Ticket[]
  refunds             Refund[]
  auditLogs           AuditLog[]
  suppliers           Supplier[]
  supplierEscalations SupplierEscalation[]
  parcels             Parcel[]

  @@index([organizationId])
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  UNINSTALLED
}

// Multi-utilisateurs prévu dès le schéma (fonctionnalité post-MVP),
// mais un seul utilisateur par marchand en pratique au départ.
model User {
  id         String   @id @default(cuid())
  merchantId String
  email      String
  name       String?
  role       UserRole @default(AGENT)
  // Désactiver coupe l'accès immédiatement sans effacer qui a fait quoi :
  // le journal d'audit référence `userId`, une suppression le rendrait muet.
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  invitedAt   DateTime?
  lastLoginAt DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@unique([merchantId, email])
  @@index([merchantId, active])
}

/// Quatre niveaux, définis par ce qu'ils peuvent casser plutôt que par
/// l'organigramme : envoyer un mail à un client, rendre de l'argent, changer
/// la configuration. Voir `src/plugins/auth.ts` pour la table des droits.
enum UserRole {
  OWNER // tout, y compris l'équipe et les réglages
  SUPERVISOR // rembourse et règle, ne gère pas l'équipe
  AGENT // répond aux clients, escalade, ne rembourse pas
  VIEWER // lecture seule
}

// ---------------------------------------------------------------------------
// Connexions OAuth (tokens chiffrés au repos, jamais en clair en base)
// ---------------------------------------------------------------------------

model ShopifyConnection {
  id             String    @id @default(cuid())
  merchantId     String    @unique
  accessTokenEnc String // AES-256-GCM, cf. src/lib/crypto.ts
  scopes         String
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

/// Une boîte mail surveillée.
///
/// Plusieurs par boutique : `contact@`, `sav@`, `retours@` arrivent dans la
/// même file mais restent distinguables, et une réponse repart de la boîte qui
/// a reçu le message — répondre à un client depuis une autre adresse que celle
/// qu'il a écrite le fait douter de son interlocuteur.
model GmailConnection {
  id           String  @id @default(cuid())
  merchantId   String
  emailAddress String
  /// Nom d'usage affiché dans l'application, à défaut de l'adresse elle-même.
  label        String?
  /// Boîte d'envoi par défaut, quand rien ne désigne celle d'origine.
  isDefault    Boolean @default(false)

  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?

  // Curseur d'ingestion incrémentale (Gmail History API).
  lastHistoryId   String?
  watchExpiration DateTime? // le watch Gmail expire après 7 jours, à renouveler

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@unique([merchantId, emailAddress])
  @@index([merchantId, isDefault])
}

// ---------------------------------------------------------------------------
// SAV
// ---------------------------------------------------------------------------

model Ticket {
  id            String @id @default(cuid())
  merchantId    String
  gmailThreadId String

  subject       String?
  customerEmail String
  customerName  String?

  intent           Intent?
  intentConfidence Float?
  status           TicketStatus @default(NEW)

  // Rattachement à la commande Shopify. Aucune valeur ici tant que
  // l'association n'est pas fiable — on ne devine jamais silencieusement.
  shopifyOrderId   String? // GID Shopify, ex. gid://shopify/Order/123
  orderName        String? // ex. #1042
  orderMatchMethod OrderMatchMethod?
  orderMatchScore  Float?

  /// Agent responsable. Nul = personne ne l'a pris, ce qui est l'état à
  /// surveiller : un ticket sans propriétaire attend indéfiniment.
  assignedToId String?

  /// Boîte mail qui a reçu le message. Détermine d'où part la réponse.
  mailboxId String?

  lastMessageAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant    Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  assignedTo  User?                @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  mailbox     GmailConnection?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  messages    Message[]
  drafts      Draft[]
  refunds     Refund[]
  escalations SupplierEscalation[]

  @@unique([merchantId, gmailThreadId])
  @@index([merchantId, status])
  @@index([merchantId, lastMessageAt])
  @@index([merchantId, assignedToId])
  @@index([merchantId, mailboxId])
}

enum Intent {
  WISMO // où est ma commande
  RETURN
  DISPUTE
  REFUND
  PRODUCT_QUESTION
  POSITIVE
  OTHER
}

enum TicketStatus {
  NEW // ingéré, pas encore traité
  PROCESSING // en cours de traitement par un worker
  DRAFT_READY // brouillon Gmail créé, en attente de validation
  NEEDS_REVIEW // ambiguïté (commande non identifiée, intention peu sûre)
  AWAITING_SUPPLIER // escalade envoyée, en attente de réponse du fournisseur
  AUTO_SENT // envoyé automatiquement (phase 3)
  CLOSED
  FAILED
}

enum OrderMatchMethod {
  ORDER_NUMBER_IN_BODY
  CUSTOMER_EMAIL
  NAME_AND_RECENT_DATE
  MANUAL
}

model Message {
  id             String           @id @default(cuid())
  merchantId     String
  ticketId       String
  gmailMessageId String
  direction      MessageDirection

  fromEmail String
  toEmail   String?
  subject   String?
  bodyText  String  @db.Text
  snippet   String?

  receivedAt DateTime
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Idempotence de l'ingestion : Pub/Sub garantit at-least-once.
  @@unique([merchantId, gmailMessageId])
  @@index([ticketId, receivedAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Draft {
  id           String  @id @default(cuid())
  merchantId   String
  ticketId     String
  gmailDraftId String?

  body       String      @db.Text
  model      String
  confidence Float
  reasoning  String?     @db.Text
  status     DraftStatus @default(PENDING_REVIEW)
  createdBy  DraftAuthor @default(AI)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([ticketId])
}

enum DraftStatus {
  PENDING_REVIEW
  EDITED
  SENT
  DISCARDED
}

enum DraftAuthor {
  AI
  HUMAN
}

// ---------------------------------------------------------------------------
// Remboursements — action financière irréversible : traçabilité obligatoire
// ---------------------------------------------------------------------------

model Refund {
  id         String  @id @default(cuid())
  merchantId String
  ticketId   String?

  shopifyOrderId  String
  shopifyRefundId String?
  amount          Decimal      @db.Decimal(12, 2)
  currency        String
  reason          String
  kind            RefundKind
  status          RefundStatus @default(PENDING)
  errorMessage    String?

  // Qui a cliqué. Jamais l'IA : le remboursement est toujours humain.
  requestedByUserId String

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
}

enum RefundKind {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Fournisseur — escalade des tickets qu'un agent ne peut pas résoudre seul
// (rupture de stock, adresse de livraison incorrecte, article manquant...).
//
// Un fournisseur par marchand en phase 1 (contrainte @unique sur merchantId).
// Le fournisseur n'a pas de mot de passe : il accède à ses échanges via un
// lien signé envoyé par email, propre à chaque escalade. Voir lib/supplierToken.ts.
// Aucune ingestion email côté fournisseur : il répond depuis le portail, pas
// par mail — ce qui évite de dupliquer le pipeline Gmail pour un second canal.
// ---------------------------------------------------------------------------

// Un marchand a rarement un seul interlocuteur : l'atelier qui répare, le
// transporteur qui perd, l'entrepôt qui se trompe de colis. Le rôle sert à
// router l'escalade vers le bon métier plutôt qu'à décrire l'entreprise.
model Supplier {
  id           String       @id @default(cuid())
  merchantId   String
  name         String
  contactEmail String
  contactName  String?
  phone        String?
  // Un fournisseur désactivé ne reçoit plus d'escalade mais garde son
  // historique : supprimer la ligne effacerait des échanges déjà consignés.
  active       Boolean      @default(true)
  notes        String?      @db.Text

  /// Version du lien de travail permanent. L'incrémenter invalide d'un coup
  /// tous les liens déjà transmis à ce fournisseur — la seule façon de révoquer
  /// un jeton signé sans table de sessions.
  portalTokenVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant    Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  escalations SupplierEscalation[]

  // Deux fiches pour la même adresse chez un même marchand n'ont pas de sens :
  // les réponses arrivant par mail seraient impossibles à attribuer.
  @@unique([merchantId, contactEmail])
  @@index([merchantId, active])
}


model SupplierEscalation {
  id         String @id @default(cuid())
  merchantId String
  ticketId   String
  supplierId String

  reason EscalationReason
  // Note libre de l'agent au moment de l'escalade — contexte pour le
  // fournisseur en plus de ce que l'IA rédige.
  note   String?          @db.Text
  status EscalationStatus @default(DRAFTING)

  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // email de notification envoyé au fournisseur
  resolvedAt DateTime?

  merchant Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ticket   Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  messages SupplierMessage[]
  parcels  Parcel[]

  @@index([merchantId, status])
  @@index([ticketId])
}

/// Un colis d'une commande, avec son numéro de suivi et sa photo.
///
/// Une commande de trois articles part souvent en trois colis, chacun avec son
/// numéro : le rang (`index` sur `total`) est ce qui permet au client comme à
/// l'agent de savoir lequel manque à l'appel.
///
/// La photo est stockée en base plutôt que sur un stockage objet : le service
/// n'en a pas, et une preuve d'expédition qui vit ailleurs que la donnée
/// qu'elle justifie finit par s'en séparer. Elle est compressée côté navigateur
/// avant l'envoi — quelques centaines de kilooctets, pas les huit mégaoctets
/// bruts d'un appareil photo de téléphone.
model Parcel {
  id           String  @id @default(cuid())
  merchantId   String
  escalationId String?

  /// Rattachement commande : le nom lisible sert au SAV, le GID aux appels
  /// Shopify. Les deux sont conservés parce que le fournisseur ne connaît que
  /// le premier.
  shopifyOrderId String?
  orderName      String?

  trackingNumber String
  carrier        String?

  index Int
  total Int

  photoMime    String?
  photoData    Bytes?
  photoTakenAt DateTime?

  /// Qui a saisi : identifiant d'utilisateur, ou nul si c'est le fournisseur
  /// depuis son lien — il n'a pas de compte.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  escalation SupplierEscalation? @relation(fields: [escalationId], references: [id], onDelete: SetNull)

  @@unique([merchantId, trackingNumber])
  @@index([merchantId, shopifyOrderId])
  @@index([escalationId])
}

enum EscalationReason {
  OUT_OF_STOCK
  INCORRECT_ADDRESS
  MISSING_ITEM
  OTHER
}

enum EscalationStatus {
  DRAFTING // message vers le fournisseur généré, pas encore envoyé
  OPEN // envoyé, en attente de réponse
  ANSWERED // le fournisseur a répondu, en attente de traitement par l'agent
  RESOLVED // clôturée par l'agent
}

model SupplierMessage {
  id           String @id @default(cuid())
  merchantId   String
  escalationId String

  direction  SupplierMessageDirection
  authorType SupplierMessageAuthor
  body       String                   @db.Text

  createdAt DateTime @default(now())

  escalation SupplierEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  @@index([escalationId, createdAt])
}

enum SupplierMessageDirection {
  TO_SUPPLIER
  FROM_SUPPLIER
}

enum SupplierMessageAuthor {
  AI
  HUMAN // l'agent, côté marchand
  SUPPLIER
}

// ---------------------------------------------------------------------------
// Journal d'audit — append-only, jamais modifié ni supprimé par l'application
// ---------------------------------------------------------------------------

model AuditLog {
  id         String @id @default(cuid())
  merchantId String

  actorType  ActorType
  actorId    String? // userId, ou identifiant du worker
  action     String // ex. refund.created, draft.sent, gmail.disconnected
  targetType String? // ex. Refund, Ticket
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([merchantId, action])
}

enum ActorType {
  USER
  SYSTEM
  AI
  SUPPLIER
}

// ---------------------------------------------------------------------------
// Configuration de la plateforme
// ---------------------------------------------------------------------------

// Identifiants de l'éditeur (clés Shopify, Google, IA) réglables depuis la
// console d'administration, sans redéploiement.
//
// Volontairement sans `merchantId` : c'est la seule table du schéma qui n'est
// pas multi-tenant, parce que son contenu appartient à la plateforme et non à
// un marchand. Toute valeur est chiffrée au repos, y compris celles qui n'en
// auraient pas besoin (nom de modèle, URL) : une seule règle vaut mieux qu'une
// liste d'exceptions à tenir à jour.
//
// Ces réglages priment sur les variables d'environnement du même nom, qui
// restent le repli — une base vide se comporte exactement comme avant.
model PlatformSetting {
  key       String   @id
  valueEnc  String
  updatedAt DateTime @updatedAt
  updatedBy String? // identifiant libre de l'administrateur, pour le journal
}
