# ---------------------------------------------------------------------------
# cSAV Copilot — variables d'environnement
# Copier en .env et remplir. Ne jamais committer le .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# URL publique de l'app (callbacks OAuth, webhooks Pub/Sub)
APP_URL=https://csav.example.com
LOG_LEVEL=info

# --- Base de données ---------------------------------------------------------
DATABASE_URL=postgresql://csav:csav@localhost:5432/csav?schema=public

# --- Redis (file BullMQ) -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Chiffrement des tokens marchands ----------------------------------------
# Clé AES-256-GCM, 32 octets encodés en base64.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Shopify Public App ------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Scopes minimaux. write_orders est requis par l'API Shopify pour créer un refund.
SHOPIFY_SCOPES=read_orders,read_customers,read_fulfillments,write_orders
SHOPIFY_API_VERSION=2025-01

# --- Google / Gmail OAuth ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Scopes sensibles -> vérification Google obligatoire avant ouverture publique.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.send

# --- Gmail Pub/Sub push ------------------------------------------------------
GOOGLE_PUBSUB_TOPIC=projects/mon-projet/topics/gmail-notifications
# Compte de service autorisé à pousser sur notre endpoint (vérif du JWT OIDC)
GOOGLE_PUBSUB_SERVICE_ACCOUNT=gmail-push@mon-projet.iam.gserviceaccount.com

# --- Console d'administration -------------------------------------------------
# Mot de passe de /admin, 12 caractères minimum. Absent, la console est
# désactivée et les identifiants ci-dessous ne se règlent que par ces variables.
# Génération : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# --- Fournisseur d'IA ---------------------------------------------------------
# "anthropic" (par défaut) ou "deepseek". Un seul point de bascule : le reste
# du code ignore lequel est actif. Voir docs/09-fournisseur-ia.md.
#
# Toutes les clés de cette section, ainsi que celles de Shopify et Google
# ci-dessus, peuvent aussi se régler depuis /admin — ce réglage prime alors sur
# la variable. Voir docs/11-console-admin.md.
AI_PROVIDER=anthropic

# --- API Claude — requis si AI_PROVIDER=anthropic ----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- API DeepSeek — requis si AI_PROVIDER=deepseek ----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Mode démonstration ------------------------------------------------------
# Mettre les deux à 1 pour faire tourner le dashboard sans boutique Shopify ni
# boîte Gmail : les commandes sont fictives, aucun mail n'est lu ni envoyé,
# aucun remboursement n'est réellement exécuté.
# Refusés au démarrage si NODE_ENV=production.
SHOPIFY_MOCK=1
GMAIL_MOCK=1
